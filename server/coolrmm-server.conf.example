# CoolRMM Server Configuration
# Copy this file to coolrmm-server.conf and edit before running the server.
# coolrmm-server.conf must sit in the same directory as coolrmm-server.exe.

# api_key — shared secret used to authenticate incoming agent requests.
# Must match the api_key in coolrmm.conf on every agent machine.
# Use a long random string — treat it like a password.
api_key=your_secret_here
